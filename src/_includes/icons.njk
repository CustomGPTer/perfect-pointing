{% macro phone(cls) %}<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/></svg>{% endmacro %}
{% macro tick() %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{% endmacro %}
{% macro trust(name) %}{% if name == 'shield' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 7v6c0 5 3.8 8.4 9 9 5.2-.6 9-4 9-9V7z"/><path d="m9 12 2 2 4-4"/></svg>{% elif name == 'plus' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>{% elif name == 'house' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16M6 20V8l6-4 6 4v12M10 20v-5h4v5"/></svg>{% elif name == 'target' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="4"/></svg>{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6 9 17l-5-5"/></svg>{% endif %}{% endmacro %}
{% macro logo() %}<svg viewBox="0 0 26 26" fill="#fff" aria-hidden="true"><rect x="1" y="2" width="11" height="6" rx="1"/><rect x="14" y="2" width="11" height="6" rx="1"/><rect x="1" y="10" width="5" height="6" rx="1"/><rect x="8" y="10" width="11" height="6" rx="1"/><rect x="21" y="10" width="4" height="6" rx="1"/><rect x="1" y="18" width="11" height="6" rx="1"/><rect x="14" y="18" width="11" height="6" rx="1"/></svg>{% endmacro %}
{% macro joint(shape) %}<svg viewBox="0 0 120 90" aria-hidden="true"><rect width="120" height="90" fill="#EFEBE5"/><rect x="10" y="10" width="100" height="26" fill="#A94B36"/><rect x="10" y="54" width="100" height="26" fill="#A94B36"/>{% if shape=='flush' %}<rect x="10" y="36" width="100" height="18" fill="#CFC7BA"/><line x1="110" y1="36" x2="110" y2="54" stroke="#1B1916" stroke-width="2"/>{% elif shape=='struck' %}<polygon points="10,36 104,36 110,54 10,54" fill="#CFC7BA"/><line x1="104" y1="36" x2="110" y2="54" stroke="#1B1916" stroke-width="2"/>{% elif shape=='bucket' %}<path d="M10 36 H110 Q102 45 110 54 H10 Z" fill="#CFC7BA"/><path d="M110 36 Q102 45 110 54" fill="none" stroke="#1B1916" stroke-width="2"/>{% elif shape=='recessed' %}<rect x="10" y="36" width="90" height="18" fill="#CFC7BA"/><line x1="100" y1="36" x2="100" y2="54" stroke="#1B1916" stroke-width="2"/>{% else %}<rect x="10" y="36" width="100" height="18" fill="#B0553E"/><rect x="10" y="41" width="104" height="8" fill="#F6F3EC"/><line x1="114" y1="41" x2="114" y2="49" stroke="#1B1916" stroke-width="2"/>{% endif %}</svg>{% endmacro %}
