---
layout: base.njk
---
{% set crumb %}<a href="/advice/">Advice</a>{% endset %}
{% set image = image or pages.advice.image %}{% set heading = title %}{% set intro = summary %}{% set extra = "" %}
{% include "phero.njk" %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":"{{ title | replace('"','\\"') }}","description":"{{ seo_description | replace('"','\\"') }}","image":"{{ site.url }}{{ image }}","url":"{{ site.url }}{{ page.url }}","author":{"@type":"Person","name":"{{ site.owner }}"},"publisher":{"@id":"{{ site.url }}/#business"},"inLanguage":"en-GB","mainEntityOfPage":"{{ site.url }}{{ page.url }}"}</script>
<section>
  <div class="wrap">
    <article class="prose article">{{ content | safe }}</article>
    <p class="note" style="margin-top:28px">Written by Scott Higginson, Perfect Pointing, Rochdale. Guide figures are ours, for Greater Manchester, and every job is quoted fixed-price after a survey.</p>
  </div>
</section>
<section class="grey">
  <div class="wrap">
    <p class="eyebrow">More advice</p>
    <div class="cards" style="margin-top:20px">{% for a in collections.advice | byOrder %}{% if a.url != page.url %}<a class="card" href="{{ a.url }}"><img class="ph" src="{{ a.data.image }}" alt="{{ a.data.title }}" loading="lazy"><div class="body"><h3>{{ a.data.title }}</h3><p>{{ a.data.summary }}</p><span class="link">Read →</span></div></a>{% endif %}{% endfor %}</div>
  </div>
</section>
{% set eyebrow = "" %}{% set heading = "Got a wall you're not sure about?" %}{% set text = "Send photos. Scott will tell you what he sees and give a rough figure before he visits." %}{% set button = "Send photos" %}
{% include "cta.njk" %}
